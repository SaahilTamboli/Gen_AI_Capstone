# Copy this file to `.env` and fill in your personal OpenRouter API key.
# `.env` is listed in `.gitignore` and must NEVER be committed to Git.

OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Role 2 — Knowledge, Retrieval & Persistent ChromaDB Vector Cache
# Allowed embedding models: qwen/qwen3-embedding-8b (multilingual EN/HI/MR), openai/text-embedding-3-small
MSME_USE_OPENROUTER_EMBEDDINGS=1
MSME_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
MSME_CHROMA_PERSIST_DIR=data/chroma

# Default OpenRouter chat model (also used if MSME_ENABLE_LLM_REWRITE=1)
MSME_LLM_MODEL=openai/gpt-4.1-mini
MSME_REWRITER_MODEL=openai/gpt-4.1-mini
MSME_ENABLE_LLM_REWRITE=0
